{
    "name": "siberfx/chat-hybrid-ai",
    "description": "API-first hybrid chat for Laravel: chat bubble, admin inbox, AI agents (Laravel AI SDK) that can search and check your data, human handoff, email transcripts, React and Vue widgets.",
    "keywords": [
        "laravel",
        "chat",
        "live-chat",
        "support",
        "ai",
        "claude",
        "messenger",
        "laravel-ai",
        "openai",
        "gemini",
        "react",
        "vue",
        "chatbot"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Siberfx",
            "email": "info@siberfx.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.30",
        "illuminate/database": "^13.30",
        "illuminate/http": "^13.30",
        "illuminate/mail": "^13.30",
        "illuminate/queue": "^13.30",
        "illuminate/support": "^13.30",
        "laravel/ai": "^1.2"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "suggest": {
        "laravel/sanctum": "Token-authenticated admin API (api/chat-admin)",
        "laravel/scout": "Full-text search for the SearchRecords tool"
    },
    "autoload": {
        "psr-4": {
            "Siberfx\\ChatHybridAi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Siberfx\\ChatHybridAi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Siberfx\\ChatHybridAi\\ChatHybridAiServiceProvider"
            ],
            "aliases": {
                "HybridChat": "Siberfx\\ChatHybridAi\\Facades\\HybridChat"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
